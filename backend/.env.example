NODE_ENV=production
PORT=5000

# AWS RDS PostgreSQL connection
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=5432
DB_NAME=shopsphere
DB_USER=shopsphere_app
DB_PASSWORD=changeme
DB_SSL=true

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173
